<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="AccentColor">#FFFF00</Color>
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AppBackground" Color="#000000" />
    <SolidColorBrush x:Key="TopBarBackground" Color="#000000" />
    <SolidColorBrush x:Key="StatusBarBackground" Color="#000000" />
    <SolidColorBrush x:Key="OverlayBackground" Color="#111111" />
    <SolidColorBrush x:Key="ErrorBarBackground" Color="#FF0000" />
</ResourceDictionary>
