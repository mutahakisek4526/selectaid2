<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="AccentColor">#00C2FF</Color>
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AppBackground" Color="#111418" />
    <SolidColorBrush x:Key="TopBarBackground" Color="#1E2328" />
    <SolidColorBrush x:Key="StatusBarBackground" Color="#1B1F24" />
    <SolidColorBrush x:Key="OverlayBackground" Color="#2A2F35" />

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="6" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="MinHeight" Value="80" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="16">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#5A6370" />
    </Style>
</ResourceDictionary>
