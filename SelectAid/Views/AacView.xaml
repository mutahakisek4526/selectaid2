<UserControl x:Class="SelectAid.Views.AacView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <GroupBox Header="History" Grid.Row="0" Grid.Column="0" Margin="8">
            <ListBox ItemsSource="{Binding History}" DisplayMemberPath="Text" FontSize="24" />
        </GroupBox>

        <GroupBox Header="Compose" Grid.Row="0" Grid.Column="1" Margin="8">
            <TextBox Text="{Binding ComposeText}" FontSize="36" TextWrapping="Wrap" AcceptsReturn="True" Height="200" />
        </GroupBox>

        <GroupBox Header="Predictions" Grid.Row="0" Grid.Column="2" Margin="8">
            <ItemsControl ItemsSource="{Binding Predictions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" Style="{StaticResource SecondaryButton}" Margin="6" Click="OnPrediction" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <GroupBox Header="Input" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="8">
            <StackPanel>
                <ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}" DisplayMemberPath="Name" Height="60" FontSize="24" />
                <ItemsControl ItemsSource="{Binding SelectedLayout.Keys}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding SelectedLayout.Columns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Style="{StaticResource PrimaryButton}" Margin="6" Click="OnKey" Height="80" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Control" Grid.Row="1" Grid.Column="2" Margin="8">
            <StackPanel>
                <Button Content="Speak" Style="{StaticResource PrimaryButton}" Margin="6" Click="OnSpeak" Height="80" />
                <Button Content="Backspace" Style="{StaticResource PrimaryButton}" Margin="6" Click="OnBackspace" Height="80" />
                <Button Content="Clear" Style="{StaticResource PrimaryButton}" Margin="6" Click="OnClear" Height="80" />
                <Button Content="Undo" Style="{StaticResource PrimaryButton}" Margin="6" Click="OnUndo" Height="80" />
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
