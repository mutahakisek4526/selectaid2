<UserControl x:Class="SelectAid.Views.TrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24">
        <TextBlock Text="Training" FontSize="28" />
        <TextBlock Text="{Binding Status}" FontSize="24" Margin="0,12,0,0" />
        <Button Content="Eye Training" Style="{StaticResource PrimaryButton}" Margin="6" Height="80" Click="OnEye" />
        <Button Content="Gyro Training" Style="{StaticResource PrimaryButton}" Margin="6" Height="80" Click="OnGyro" />
        <Button Content="Scan Training" Style="{StaticResource PrimaryButton}" Margin="6" Height="80" Click="OnScan" />
    </StackPanel>
</UserControl>
