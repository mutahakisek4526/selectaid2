<UserControl x:Class="SelectAid.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24">
        <Button Content="Refresh" Style="{StaticResource PrimaryButton}" Margin="6" Height="80" Click="OnRefresh" />
        <TextBox Text="{Binding LogText}" FontSize="28" TextWrapping="Wrap" AcceptsReturn="True" Height="400" />
    </StackPanel>
</UserControl>
