<UserControl x:Class="SelectAid.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <UniformGrid Columns="3" Margin="24" HorizontalAlignment="Center">
            <Button Style="{StaticResource PrimaryButton}" Content="AAC" Click="OnAac" Margin="12" Height="120" />
            <Button Style="{StaticResource PrimaryButton}" Content="Phrases" Click="OnPhrases" Margin="12" Height="120" />
            <Button Style="{StaticResource PrimaryButton}" Content="Keyboard Layouts" Click="OnLayouts" Margin="12" Height="120" />
            <Button Style="{StaticResource PrimaryButton}" Content="Overlay" Click="OnOverlay" Margin="12" Height="120" />
            <Button Style="{StaticResource PrimaryButton}" Content="Settings" Click="OnSettings" Margin="12" Height="120" />
            <Button Style="{StaticResource PrimaryButton}" Content="Supporter" Click="OnSupporter" Margin="12" Height="120" />
            <Button Style="{StaticResource PrimaryButton}" Content="Training" Click="OnTraining" Margin="12" Height="120" />
            <Button Style="{StaticResource PrimaryButton}" Content="Logs" Click="OnLogs" Margin="12" Height="120" />
            <Button Style="{StaticResource PrimaryButton}" Content="Backup/Restore" Click="OnBackup" Margin="12" Height="120" />
        </UniformGrid>
    </ScrollViewer>
</UserControl>
