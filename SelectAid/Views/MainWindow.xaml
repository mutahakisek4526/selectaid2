<Window x:Class="SelectAid.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SelectAid.ViewModels"
        xmlns:views="clr-namespace:SelectAid.Views"
        Title="SelectAid" WindowState="Maximized" Background="{DynamicResource AppBackground}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AacViewModel}">
            <views:AacView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PhrasesViewModel}">
            <views:PhrasesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KeyboardLayoutsViewModel}">
            <views:KeyboardLayoutsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OverlayPanelViewModel}">
            <views:OverlayPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SupporterViewModel}">
            <views:SupporterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrainingViewModel}">
            <views:TrainingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupRestoreViewModel}">
            <views:BackupRestoreView />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="{DynamicResource TopBarBackground}" Height="96">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="12" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Content="Home" Width="120" Margin="6" Click="OnHome" />
                <Button Style="{StaticResource PrimaryButton}" Content="Back" Width="120" Margin="6" Click="OnBack" />
                <Button Style="{StaticResource PrimaryButton}" Content="Undo" Width="120" Margin="6" Click="OnUndo" />
                <Button Style="{StaticResource PrimaryButton}" Content="Pause" Width="120" Margin="6" Click="OnPause" />
                <Button Style="{StaticResource PrimaryButton}" Content="Buzzer" Width="120" Margin="6" Click="OnBuzzer" />
                <Button Style="{StaticResource PrimaryButton}" Content="PC" Width="120" Margin="6" Click="OnPc" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="SelectAid" Foreground="{DynamicResource TextPrimary}" FontSize="32" VerticalAlignment="Center" Margin="12" />
        </DockPanel>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />

        <Border Grid.Row="2" Background="{DynamicResource StatusBarBackground}" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                <TextBlock Text="Input: " Foreground="{DynamicResource TextPrimary}" FontSize="20" />
                <TextBlock Text="{Binding InputModeLabel}" Foreground="{DynamicResource Accent}" FontSize="20" Margin="0,0,16,0" />
                <TextBlock Text="Status: " Foreground="{DynamicResource TextPrimary}" FontSize="20" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Accent}" FontSize="20" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
