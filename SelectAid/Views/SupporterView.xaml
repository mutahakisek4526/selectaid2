<UserControl x:Class="SelectAid.Views.SupporterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SelectAid.Models"
             xmlns:local="clr-namespace:SelectAid.Views">
    <ScrollViewer>
        <StackPanel Margin="24">
            <TextBlock Text="Supporter" FontSize="28" />
            <TextBlock Text="Profile" FontSize="28" Margin="0,12,0,0" />
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding CurrentProfile}" DisplayMemberPath="Name" FontSize="28" Height="60" />
            <TextBlock Text="Input Mode" FontSize="28" Margin="0,12,0,0" />
            <ComboBox SelectedItem="{Binding InputMode}" FontSize="28" Height="60">
                <ComboBox.ItemsSource>
                    <x:Array Type="models:InputMode">
                        <models:InputMode>EyeOnly</models:InputMode>
                        <models:InputMode>EyeSwitch</models:InputMode>
                        <models:InputMode>EyeGyro</models:InputMode>
                        <models:InputMode>GyroOnly</models:InputMode>
                        <models:InputMode>SwitchScan</models:InputMode>
                    </x:Array>
                </ComboBox.ItemsSource>
            </ComboBox>
            <TextBlock Text="Theme" FontSize="28" Margin="0,12,0,0" />
            <ComboBox SelectedItem="{Binding ThemeId}" FontSize="28" Height="60">
                <ComboBox.ItemsSource>
                    <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                        <sys:String>Friendly</sys:String>
                        <sys:String>Stylish</sys:String>
                        <sys:String>Kids</sys:String>
                    </x:Array>
                </ComboBox.ItemsSource>
            </ComboBox>
            <CheckBox Content="Auto Start" IsChecked="{Binding AutoStartEnabled}" FontSize="28" Margin="0,12,0,0" />

            <TextBlock Text="Power Permissions" FontSize="28" Margin="0,24,0,0" />
            <CheckBox Content="Allow Shutdown" IsChecked="{Binding Safety.AllowShutdown}" FontSize="28" />
            <CheckBox Content="Allow Restart" IsChecked="{Binding Safety.AllowRestart}" FontSize="28" />
            <CheckBox Content="Allow Sleep" IsChecked="{Binding Safety.AllowSleep}" FontSize="28" />
            <CheckBox Content="Allow Logoff" IsChecked="{Binding Safety.AllowLogoff}" FontSize="28" />

            <TextBlock Text="Power Actions (Long Press)" FontSize="28" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal">
                <local:LongPressButton Content="Shutdown" Style="{StaticResource PrimaryButton}" Margin="6" LongPressed="OnShutdown" />
                <local:LongPressButton Content="Restart" Style="{StaticResource PrimaryButton}" Margin="6" LongPressed="OnRestart" />
                <local:LongPressButton Content="Sleep" Style="{StaticResource PrimaryButton}" Margin="6" LongPressed="OnSleep" />
                <local:LongPressButton Content="Logoff" Style="{StaticResource PrimaryButton}" Margin="6" LongPressed="OnLogoff" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
