<UserControl x:Class="SelectAid.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24">
        <TextBlock Text="UI設定" FontSize="28" Margin="0,0,0,12" />
        <CheckBox Content="高コントラスト" IsChecked="{Binding Profile.Ui.HighContrast}" FontSize="24" />
        <TextBlock Text="Density" FontSize="24" Margin="0,12,0,0" />
        <TextBox Text="{Binding Profile.Ui.DensityLimit}" Width="120" FontSize="24" />
    </StackPanel>
</UserControl>
