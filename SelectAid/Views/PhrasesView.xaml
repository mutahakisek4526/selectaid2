<UserControl x:Class="SelectAid.Views.PhrasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListBox Grid.Row="0" ItemsSource="{Binding Catalog.Scenes[0].Categories[0].Items}" DisplayMemberPath="Text" FontSize="28" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBox Width="400" FontSize="28" Text="{Binding NewPhrase}" />
            <Button Content="追加" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="OnAdd" Height="80" />
        </StackPanel>
    </Grid>
</UserControl>
