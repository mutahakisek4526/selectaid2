<Window x:Class="SelectAid.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay" WindowStyle="None" AllowsTransparency="True" Background="#66000000" Topmost="True"
        Width="420" Height="640" WindowStartupLocation="CenterScreen">
    <Border Background="{DynamicResource OverlayBackground}" CornerRadius="16" Padding="12">
        <UniformGrid Columns="2">
            <Button Content="Left" Style="{StaticResource PrimaryButton}" Click="OnLeft" />
            <Button Content="Right" Style="{StaticResource PrimaryButton}" Click="OnRight" />
            <Button Content="Double" Style="{StaticResource PrimaryButton}" Click="OnDouble" />
            <Button Content="Drag" Style="{StaticResource PrimaryButton}" Click="OnDragToggle" />
            <Button Content="Scroll +" Style="{StaticResource PrimaryButton}" Click="OnScrollUp" />
            <Button Content="Scroll -" Style="{StaticResource PrimaryButton}" Click="OnScrollDown" />
            <Button Content="Back" Style="{StaticResource PrimaryButton}" Click="OnBack" />
            <Button Content="Tab" Style="{StaticResource PrimaryButton}" Click="OnTab" />
            <Button Content="ShiftTab" Style="{StaticResource PrimaryButton}" Click="OnShiftTab" />
            <Button Content="Enter" Style="{StaticResource PrimaryButton}" Click="OnEnter" />
            <Button Content="Space" Style="{StaticResource PrimaryButton}" Click="OnSpace" />
            <Button Content="Backspace" Style="{StaticResource PrimaryButton}" Click="OnBackspace" />
            <Button Content="MouseGrid" Style="{StaticResource PrimaryButton}" Click="OnMouseGrid" />
            <Button Content="Transparent" Style="{StaticResource SecondaryButton}" Click="OnTransparent" />
            <Button Content="Home" Style="{StaticResource SecondaryButton}" Click="OnHome" />
            <Button Content="Pause" Style="{StaticResource SecondaryButton}" Click="OnPause" />
        </UniformGrid>
    </Border>
</Window>
